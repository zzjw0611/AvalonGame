# Copy to .env on YOUR SERVER only. Never commit real credentials.
DOMAIN=avalon.example.com
# Generate each independently with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
ACCESS_CODE=REPLACE_WITH_PRIVATE_INVITATION_CODE
APP_ENV=production
# Blank values mean no LLM profile is exposed; clearly labelled rule bots still work.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=25
LLM_MAX_TOKENS=450
LLM_CONCURRENCY=4
LLM_CALL_BUDGET=300
BOT_DELAY_SECONDS=1.2
# Optional multiple server-side providers. Client only receives profile id and label.
# LLM_PROFILES_JSON='[{"id":"model-a","label":"Model A","base_url":"https://provider.example/v1","model":"YOUR_MODEL_ID","api_key_env":"MODEL_A_KEY","json_mode":true,"token_parameter":"max_tokens"}]'
# MODEL_A_KEY=
