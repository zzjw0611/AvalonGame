{
  "name": "avalon-native",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "check:expo": "expo install --check"
  },
  "dependencies": {
    "expo": "56.0.22",
    "expo-constants": "56.0.26",
    "expo-dev-client": "56.0.27",
    "expo-linking": "56.0.18",
    "expo-router": "56.2.21",
    "expo-secure-store": "56.0.4",
    "expo-status-bar": "56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-gesture-handler": "2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "19.2.2",
    "jest": "29.7.0",
    "jest-expo": "56.0.5",
    "typescript": "6.0.3",
    "@jest/globals": "29.7.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
